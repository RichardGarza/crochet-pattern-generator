{
  "name": "crochet-pattern-generator",
  "private": true,
  "version": "0.1.0",
  "description": "Turns pictures, photos and 3D models into crochet patterns. Runs locally in the browser.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "npm@11.21.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.12",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=11",
      "onFail": "warn"
    }
  },
  "scripts": {
    "predev": "node scripts/check-node.mjs",
    "dev": "vite",
    "prebuild": "node scripts/check-node.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "pretest": "node scripts/check-node.mjs",
    "test": "vitest run",
    "pretypecheck": "node scripts/check-node.mjs",
    "typecheck": "tsc -b",
    "prelint": "node scripts/check-node.mjs",
    "lint": "oxlint",
    "preperf": "node scripts/check-node.mjs",
    "perf": "node scripts/perf.mjs",
    "pree2e": "node scripts/check-node.mjs",
    "e2e": "playwright test",
    "schema": "tsx scripts/gen-schema.ts",
    "fixtures": "node scripts/make-fixtures.mjs",
    "cd-fixtures": "node scripts/make-cd-fixtures.mjs",
    "copy-ort": "node scripts/copy-ort.mjs",
    "postinstall": "node scripts/copy-ort.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "acorn": "^8.18.0",
    "comlink": "^4.4.2",
    "fflate": "^0.8.3",
    "idb": "^8.0.3",
    "immer": "^11.1.18",
    "json5": "^2.2.3",
    "jspdf": "^4.2.1",
    "manifold-3d": "^3.5.4",
    "meshoptimizer": "^1.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "svg2pdf.js": "^2.8.1",
    "three": "^0.186.1",
    "three-mesh-bvh": "^0.9.15",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.14.5",
    "oxlint": "^1.86.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.1",
    "vitest": "^4.1.11"
  }
}
