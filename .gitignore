.DS_Store
node_modules/
.env

# Local env files (may hold keys; this repository is public)
*.local
*.log

# Agent worktrees, one per track (docs/DESIGN.md §6.1 rule 2)
.claude/worktrees

# Test and build output (anchored to the repository root, so a source folder may still be called "dist" or "coverage")
/test-results/
/playwright-report/
/coverage/
/dist/
/.cache/

# Generated by scripts/copy-ort.mjs (postinstall)
public/ort/

# The user's real photo sets stay on this machine (docs/DESIGN.md §6.1 rule 9, docs/CAPTURE.md).
# Only each object's expected.json and README.md are tracked.
fixtures/images/3d/real/**
!fixtures/images/3d/real/**/
!fixtures/images/3d/real/**/expected.json
!fixtures/images/3d/real/**/README.md
